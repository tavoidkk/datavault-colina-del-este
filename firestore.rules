rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /contacts/{phoneId} {
      allow read: if true;

      allow create: if
        !exists(/databases/$(database)/documents/contacts/$(phoneId)) &&
        request.resource.data.keys().hasAll([
          'phone', 'phoneNormalized', 'name', 'category',
          'addedBy', 'floor', 'apartment',
          'ratingSum', 'ratingCount', 'averageRating', 'createdAt'
        ]) &&
        request.resource.data.ratingSum == 0 &&
        request.resource.data.ratingCount == 0 &&
        request.resource.data.averageRating == 0 &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.floor is int &&
        request.resource.data.floor >= 1 &&
        request.resource.data.floor <= 13 &&
        request.resource.data.apartment in ['A', 'B', 'C'];

      allow update: if
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['ratingSum', 'ratingCount', 'averageRating']);

      allow delete: if false;
    }

    match /votes/{voteId} {
      allow read: if true;

      allow create: if
        !exists(/databases/$(database)/documents/votes/$(voteId)) &&
        request.resource.data.keys().hasAll([
          'contactPhone', 'deviceId', 'rating', 'createdAt'
        ]) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow update, delete: if false;
    }
  }
}
